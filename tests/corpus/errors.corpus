# unknown names
foo(1, 2)                   => !error Unknown function "foo"

# inconvertible units
1meter to s                 => !error
1m to 150                   => !error

# currency conversion without a rate provider
1 usd to eur                => !error No conversion rate available for usd.

# an unclosed group, which used to be accepted silently
(1 + 2                      => !error Expected ) to close the group
((1                         => !error Expected ) to close the group
(1 + (2                     => !error Expected ) to close the group
